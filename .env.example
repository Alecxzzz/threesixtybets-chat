VITE_API_URL=https://xn--sixtyserver--b61q52a.up.railway.app
# URL del microservicio de datos (prop_cache_service). Si se omite, usa VITE_API_URL.
# Ejemplo: https://tu-servicio-de-datos.up.railway.app
VITE_DATA_API_URL=
# URL del proxy HLS en producción (endpoint /hls-proxy del backend FastAPI).
# Si se deja vacío, stream.js usa `${VITE_API_URL}/hls-proxy` (mismo host que la API).
# En dev, vacío = plugin de Vite (vite-plugins/hls-proxy.js).
VITE_HLS_PROXY=https://xn--sixtyserver--b61q52a.up.railway.app/hls-proxy
